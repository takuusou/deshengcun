page {
  --beni: #A63D2F;
  --beni-l: #C04535;
  --beni-d: #8A2E22;
  --beni-pale: #FBEEEC;
  --beni-pale-2: #F5E0DC;

  --ink: #1A1612;
  --ink-2: #3A332C;
  --ink-3: #7A6E64;
  --ink-4: #B8AFA3;

  --bg: #FFFFFF;
  --bg-2: #FAF8F4;
  --line: #EFEBE2;
  --line-2: #E8E2D5;

  --matcha: #3D6B35;
  --matcha-bg: #E8F0E2;
  --kincha: #8C6D2F;
  --kincha-bg: #F5EDD9;

  /* 兼容旧变量名（历史页面仍使用） */
  --color-primary: #A63D2F;
  --color-primary-light: #C04535;
  --color-primary-dark: #8A2E22;
  --color-primary-pale: #FBEEEC;
  --color-ink: #1A1612;
  --color-washi: #FAF8F4;
  --color-washi-d: #EFEBE2;
  --color-washi-dd: #E8E2D5;
  --color-shiro: #FFFFFF;
  --color-matcha: #3D6B35;
  --color-kincha: #8C6D2F;
  --color-text-main: #1A1612;
  --color-text-sub: #7A6E64;
  --color-text-hint: #B8AFA3;
  --radius-card: 14rpx;
  --radius-chip: 18rpx;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  font-family: 'Noto Sans SC', 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* ── 字体 ── */
.font-serif {
  font-family: 'STSong', 'Songti SC', 'SimSun', serif;
}

/* ── 章节标题 ── */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
  margin-top: 48rpx;
  margin-bottom: 0rpx;
}
.sec-head-l {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.sec-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--beni);
  flex-shrink: 0;
}
.sec-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 1rpx;
  font-family: 'STSong', 'Songti SC', 'SimSun', serif;
}
.sec-subtitle {
  font-size: 22rpx;
  color: var(--ink-4);
}
.sec-more {
  font-size: 24rpx;
  color: var(--beni);
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* ── 按钮 ── */
.btn-beni {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--beni) 0%, var(--beni-l) 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  margin: 0;
  box-shadow: 0 12rpx 24rpx rgba(166, 61, 47, 0.22);
  letter-spacing: 4rpx;
}
.btn-beni:active { opacity: 0.85; }

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: var(--ink-2);
  border: 1rpx solid var(--line-2);
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 400;
  min-height: 80rpx;
  line-height: 80rpx;
  padding: 0 28rpx;
  box-sizing: border-box;
  margin: 0;
}
.btn-ghost:active { opacity: 0.75; }

/* 兼容旧类名 */
.btn-primary {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--beni) 0%, var(--beni-l) 100%);
  color: #fff;
  border-radius: 18rpx;
  white-space: nowrap;
  min-height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 22rpx;
  box-sizing: border-box;
  margin: 0;
  box-shadow: 0 12rpx 24rpx rgba(166, 61, 47, 0.18);
}
.btn-secondary {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: var(--ink);
  border-radius: 18rpx;
  white-space: nowrap;
  min-height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 22rpx;
  box-sizing: border-box;
  margin: 0;
  border: 1rpx solid var(--line-2);
}

button { box-sizing: border-box; }
button::after { border: 0; }

/* ── 状态徽章 ── */
.badge {
  display: inline-flex;
  align-items: center;
  font-size: 21rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}
.badge-processing { color: var(--beni); background: var(--beni-pale); }
.badge-pending    { color: var(--kincha); background: var(--kincha-bg); }
.badge-done       { color: var(--matcha); background: var(--matcha-bg); }
.badge-reject     { color: #8B4341; background: #F0E0DF; }

/* ── 信息卡 ── */
.info-card {
  background: var(--beni-pale);
  border-left: 6rpx solid var(--beni);
  border-radius: 0 12rpx 12rpx 0;
  padding: 24rpx 28rpx;
  margin: 0 36rpx;
}
.info-card-title {
  font-size: 26rpx;
  color: var(--beni);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.info-card-body {
  font-size: 23rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

/* ── 表单组件 ── */
.form { padding: 0 36rpx; }
.form-group { margin-bottom: 32rpx; }
.form-label {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: var(--ink-2);
  margin-bottom: 12rpx;
  font-weight: 500;
}
.form-label-required::before {
  content: '*';
  color: var(--beni);
  margin-right: 4rpx;
}
.form-input {
  width: 100%;
  display: block;
  background: var(--bg);
  border: 1rpx solid var(--line-2);
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--ink);
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
}
.form-input:focus { border-color: var(--beni); }
.form-input.disabled { background: var(--bg-2); color: var(--ink-3); }
textarea.form-input {
  height: auto;
  min-height: 160rpx;
  line-height: 1.6;
  padding: 20rpx 24rpx;
}
.form-select {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg);
  border: 1rpx solid var(--line-2);
  border-radius: 16rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--ink);
  height: 80rpx;
  padding: 0 24rpx;
}
.form-select-arrow { font-size: 24rpx; color: var(--ink-4); }
.form-chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.form-chip {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-2);
  font-size: 26rpx;
  color: var(--ink-3);
  background: var(--bg);
}
.form-chip.on {
  border-color: var(--beni);
  background: var(--beni-pale);
  color: var(--beni);
  font-weight: 500;
}
.form-tip {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-4);
  line-height: 1.5;
}
.form-tip-warn { color: var(--kincha); }
.form-footer {
  padding: 40rpx 36rpx 60rpx;
}
.form-footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-4);
  margin-top: 16rpx;
}

/* ── 图片上传 ── */
.form-upload {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
}
.form-upload-item {
  aspect-ratio: 1;
  border: 1rpx dashed var(--line-2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: var(--ink-4);
  background: var(--bg-2);
}
.form-upload-img {
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.form-upload-img image { width: 100%; height: 100%; display: block; }
.form-upload-img-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

/* ── 空状态 ── */
.empty {
  text-align: center;
  padding: 64rpx 36rpx 40rpx;
  background: var(--bg-2);
  border: 1rpx solid var(--line-2);
  border-radius: 24rpx;
  margin: 48rpx 36rpx 0;
}
.empty-illust {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin: 0 auto 20rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink);
  font-family: 'STSong', 'Songti SC', serif;
}
.empty-desc {
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 10rpx;
  line-height: 1.6;
}
.empty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--beni) 0%, var(--beni-l) 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 26rpx;
  padding: 16rpx 48rpx;
  margin-top: 24rpx;
  letter-spacing: 3rpx;
}

/* ── 二级导航栏 ── */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 50;
  height: 96rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx;
}
.navbar-back {
  position: absolute;
  left: 28rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink-2);
}
.navbar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  font-family: 'STSong', 'Songti SC', serif;
}
.has-navbar { padding-top: 96rpx; }

/* ── 工具类 ── */
.row { display: flex; gap: 16rpx; align-items: stretch; }
.row > view { flex: 1; min-width: 0; }
.muted { color: var(--ink-3); font-size: 24rpx; }
.ui-loading-inline { padding: 20rpx 0; text-align: center; color: var(--ink-4); }
.ui-mt-4  { margin-top: 4rpx; }
.ui-mt-8  { margin-top: 8rpx; }
.ui-mt-10 { margin-top: 10rpx; }
.ui-mt-12 { margin-top: 12rpx; }
.ui-mt-14 { margin-top: 14rpx; }
.ui-mt-18 { margin-top: 18rpx; }
.ui-mt-20 { margin-top: 20rpx; }
.ui-mb-20 { margin-bottom: 20rpx; }
.ui-text-center { text-align: center; }
.ui-grid-span-2 { grid-column: span 2; }

/* ── 历史兼容样式（不改动） ── */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 22, 18, 0.05);
  border: 1rpx solid rgba(224, 214, 194, 0.92);
}
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--ink);
}
.input, .textarea, .picker {
  width: 100%;
  display: block;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid var(--line-2);
  border-radius: 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: var(--ink);
}
.input, .picker { height: 76rpx; line-height: 76rpx; padding: 0 20rpx; }
.textarea { min-height: 170rpx; width: 100%; padding: 18rpx 20rpx; line-height: 1.6; }
.field { margin-bottom: 16rpx; }
.label { display: block; margin-bottom: 8rpx; color: var(--ink-3); }
.photo-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.photo-item {
  flex: 0 0 150rpx; width: 150rpx; height: 150rpx;
  border-radius: 18rpx; overflow: hidden; position: relative;
  background: var(--bg-2); border: 1rpx solid var(--line);
}
.photo-image { width: 100%; height: 100%; display: block; }
.photo-remove {
  position: absolute; top: 0; right: 0;
  width: 34rpx; height: 34rpx; line-height: 34rpx;
  text-align: center; border-bottom-left-radius: 10rpx;
  background: rgba(26, 22, 18, 0.72); color: #fff; font-size: 24rpx;
}
.photo-add {
  flex: 0 0 150rpx; width: 150rpx; height: 150rpx;
  border: 1rpx dashed var(--beni); border-radius: 18rpx;
  color: var(--beni); background: var(--beni-pale);
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 600; text-align: center;
  box-sizing: border-box; padding: 0 12rpx;
}
.v11-page {
  background: var(--bg);
  min-height: 100vh;
}
.has-fixed-topbar { padding-top: 160rpx; box-sizing: border-box; }
.v11-topbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 30;
  background: linear-gradient(135deg, var(--beni-d) 0%, var(--beni) 48%, var(--beni-l) 100%);
  color: #fff;
  border-bottom-left-radius: 24rpx; border-bottom-right-radius: 24rpx;
  min-height: 160rpx;
  padding: 26rpx 44rpx 30rpx; box-sizing: border-box;
  box-shadow: 0 18rpx 36rpx rgba(166, 61, 47, 0.24);
  overflow: hidden;
}
.v11-topbar--square-centered {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  padding-top: 0;
  padding-bottom: 0;
  display: flex;
  align-items: center;
}
.v11-topbar-copy { position: relative; z-index: 1; max-width: calc(100% - 190rpx); }
.v11-topbar-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.v11-topbar-title {
  font-size: 42rpx; font-weight: 600; letter-spacing: 2rpx;
  line-height: 1.18;
  font-family: 'STSong', 'Songti SC', serif;
}
.v11-topbar-sub { margin-top: 8rpx; font-size: 24rpx; line-height: 1.5; color: rgba(255,255,255,0.82); letter-spacing: 1rpx; }
.v11-topbar-ring {
  position: absolute;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  box-sizing: border-box;
  pointer-events: none;
}
.v11-topbar-ring--large {
  width: 218rpx;
  height: 218rpx;
  right: -92rpx;
  top: -70rpx;
}
.v11-topbar-ring--small {
  width: 174rpx;
  height: 174rpx;
  right: -22rpx;
  top: 78rpx;
}
.v11-hero {
  position: relative;
  min-height: 160rpx;
  padding: 26rpx 44rpx 30rpx;
  box-sizing: border-box;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(135deg, var(--beni-d) 0%, var(--beni) 48%, var(--beni-l) 100%);
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
}
.v11-hero--square-centered {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  padding-top: 0;
  padding-bottom: 0;
  display: flex;
  align-items: center;
}
.v11-hero-copy { position: relative; z-index: 1; max-width: calc(100% - 190rpx); }
.v11-hero-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.18;
  letter-spacing: 2rpx;
}
.v11-hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 1rpx;
}
.v11-content { padding: 0 24rpx 30rpx; }
.v11-section {
  margin-bottom: 22rpx; background: rgba(255,255,255,0.94);
  border-radius: 24rpx; overflow: hidden;
  border: 1rpx solid var(--line); box-shadow: 0 16rpx 34rpx rgba(82, 56, 35, 0.08);
}
.v11-section-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 24rpx; font-size: 38rpx; font-weight: 600;
  color: var(--ink); font-family: 'STSong', 'Songti SC', serif;
}
.v11-link-text { font-size: 26rpx; color: var(--beni); font-weight: 500; }
.v11-divider { height: 1rpx; background: var(--line); }
.v11-list { padding: 0 24rpx; }
.v11-list-item { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.v11-list-item:last-child { border-bottom: 0; }
.v11-list-title { font-size: 34rpx; color: var(--ink); font-weight: 600; }
.v11-list-sub { margin-top: 8rpx; font-size: 24rpx; color: var(--ink-3); }
.v11-pill-tabs {
  display: flex; background: rgba(255,255,255,0.92); border-radius: 24rpx;
  margin-bottom: 20rpx; overflow: hidden;
  border: 1rpx solid var(--line); box-shadow: 0 14rpx 30rpx rgba(82, 56, 35, 0.06);
}
.v11-pill-tab { flex: 1; text-align: center; padding: 18rpx 0; font-size: 32rpx; color: var(--ink-3); border-bottom: 4rpx solid transparent; }
.v11-pill-tab.active { color: var(--beni); font-weight: 700; border-bottom-color: var(--beni); }
.v11-scroller-tabs {
  white-space: nowrap; background: rgba(255,255,255,0.92);
  border-radius: 24rpx; border: 1rpx solid var(--line);
  box-shadow: 0 14rpx 30rpx rgba(82, 56, 35, 0.06); margin-bottom: 20rpx;
}
.v11-scroller-row { display: inline-flex; min-width: 100%; }
.v11-scroller-tab { padding: 18rpx 24rpx; font-size: 34rpx; color: var(--ink-3); border-bottom: 4rpx solid transparent; }
.v11-scroller-tab.active { color: var(--beni); font-weight: 700; border-bottom-color: var(--beni); }
.v11-icon-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20rpx 12rpx; padding: 20rpx 16rpx 24rpx; }
.v11-icon-item { text-align: center; }
.v11-icon-circle {
  width: 112rpx; height: 112rpx; border-radius: 56rpx;
  margin: 0 auto 10rpx; background: var(--beni-pale); color: var(--beni);
  font-size: 48rpx; display: flex; align-items: center; justify-content: center;
}
.v11-icon-title { font-size: 30rpx; color: var(--ink); }
.v11-icon-sub { margin-top: 4rpx; font-size: 22rpx; color: var(--ink-3); }
.cadre-page {
  background: var(--bg-2); min-height: 100vh; padding-bottom: 140rpx;
}
.cadre-topbar {
  background: linear-gradient(135deg, var(--beni-d) 0%, var(--beni) 48%, var(--beni-l) 100%);
  color: #fff; padding: 24rpx;
  border-bottom-left-radius: 24rpx; border-bottom-right-radius: 24rpx;
  box-shadow: 0 18rpx 36rpx rgba(166, 61, 47, 0.22);
}
.cadre-topbar-title { font-size: 40rpx; font-weight: 600; font-family: 'STSong', 'Songti SC', serif; }
.cadre-topbar-sub { margin-top: 8rpx; font-size: 24rpx; opacity: 0.95; }
.cadre-content { padding: 20rpx 24rpx 30rpx; }
.cadre-nav {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; background: rgba(255,255,255,0.96);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -12rpx 28rpx rgba(82, 56, 35, 0.1); z-index: 999;
}
.cadre-nav-item { flex: 1; text-align: center; padding: 14rpx 0 20rpx; color: var(--ink-3); font-size: 24rpx; }
.cadre-nav-item.active { color: var(--beni); font-weight: 700; }
.cadre-nav-icon { width: 42rpx; height: 42rpx; margin: 0 auto 6rpx; display: block; }
.cadre-grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.cadre-stat-card {
  border-radius: 20rpx; padding: 16rpx;
  background: linear-gradient(160deg, #fff 0%, var(--bg-2) 100%);
  border: 1rpx solid var(--line);
}
.cadre-stat-value { font-size: 42rpx; font-weight: 700; color: var(--beni); }
.cadre-stat-label { margin-top: 6rpx; color: var(--ink-3); font-size: 24rpx; }

/* 旧的通知详情兼容 */
.ui-topbar-role { font-size: 28rpx; }
.ui-topbar-role-small { font-size: 26rpx; }
.ui-section-body { padding: 0 24rpx 24rpx; }
.ui-list-row { padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.ui-list-row:last-child { border-bottom: 0; }
.ui-list-row-title { font-weight: 600; color: var(--ink); line-height: 1.5; }
.ui-text-body { color: var(--ink-3); line-height: 1.6; }
.ui-warning-panel { padding: 22rpx 24rpx; color: var(--beni); font-size: 34rpx; line-height: 1.6; }
