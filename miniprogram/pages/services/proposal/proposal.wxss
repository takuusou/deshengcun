page {
  background: #f6f4ef;
}

.proposal-page {
  min-height: 100vh;
  background: #f6f4ef;
}

/* 内容区 */
.proposal-body {
  padding: 36rpx 32rpx 48rpx;
}

.lead {
  font-size: 27rpx;
  color: #3a332c;
  line-height: 1.85;
}

.lead .hl {
  color: #a63d2f;
  font-weight: 500;
}

/* 匿名提示条 */
.anon {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f5e8e6;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  margin: 28rpx 0 32rpx;
}

.anon-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.anon-text {
  font-size: 23rpx;
  color: #8a2e22;
  line-height: 1.6;
}

/* 输入区 */
.field-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.label-bar {
  width: 6rpx;
  height: 28rpx;
  background: #a63d2f;
  border-radius: 3rpx;
}

.label-title {
  font-size: 32rpx;
  color: #1a1612;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.proposal-textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 320rpx;
  border: 1rpx solid #e8e0d0;
  border-radius: 24rpx;
  padding: 28rpx;
  font-size: 28rpx;
  color: #1a1612;
  line-height: 1.8;
  background: #fff;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #b8afa3;
  margin-top: 14rpx;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  background: #a63d2f;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  margin-top: 32rpx;
  box-shadow: 0 12rpx 24rpx -14rpx rgba(166, 61, 47, 0.6);
}

.submit-btn::after {
  border: none;
}

/* 成功态 */
.success {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 120rpx 40rpx 60rpx;
}

.succ-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #f5e8e6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 70rpx;
  color: #a63d2f;
  margin-bottom: 40rpx;
}

.succ-title {
  font-size: 40rpx;
  color: #1a1612;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}

.succ-text {
  font-size: 26rpx;
  color: #7a6e64;
  line-height: 1.9;
  white-space: pre-line;
  max-width: 480rpx;
}

.succ-btn {
  margin-top: 56rpx;
  padding: 0 80rpx;
  height: 84rpx;
  line-height: 84rpx;
  border: 1rpx solid #e8e0d0;
  border-radius: 24rpx;
  background: #fff;
  color: #3a332c;
  font-size: 28rpx;
}

.succ-btn::after {
  border: none;
}

.succ-again {
  margin-top: 28rpx;
  font-size: 25rpx;
  color: #a63d2f;
}
