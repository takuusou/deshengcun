.open-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

.h-brand {
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%),
    linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
  padding: 28rpx 44rpx 32rpx;
  position: relative;
  overflow: hidden;
}
.h-brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  min-height: 72rpx;
}
.h-brand-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 44rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 6rpx;
  line-height: 1.2;
}

.open-body {
  padding: 32rpx 32rpx 26rpx;
}

/* 村部大图 */
.open-hero {
  position: relative;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 32rpx;
  margin-bottom: 36rpx;
  background: linear-gradient(135deg, #B14536, #8A2E22);
}
.open-hero-image {
  width: 100%;
  height: 100%;
  display: block;
}
.open-hero-placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}
.open-hero-placeholder-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.78;
  filter: brightness(0) invert(1);
}
.open-hero-placeholder text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.78);
  letter-spacing: 4rpx;
}
.open-hero-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx 28rpx 22rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.45), transparent);
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.open-hero-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #fff;
  opacity: 0.86;
}
.open-hero-caption text {
  color: #fff;
  font-size: 25rpx;
  letter-spacing: 3rpx;
  font-family: 'STSong', 'Songti SC', serif;
  font-weight: 500;
}

/* 数据带 */
.open-data-bar {
  display: flex;
  align-items: stretch;
  margin-bottom: 44rpx;
  padding: 30rpx 8rpx;
  border-radius: 28rpx;
  border: 1rpx solid #E8E0D0;
  background: #fff;
}
.open-data-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}
.open-data-cell + .open-data-cell::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 72rpx;
  background: #E6E1D6;
}
.open-data-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.open-data-icon image {
  width: 36rpx;
  height: 36rpx;
}
.open-data-num {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 42rpx;
  color: var(--ink);
  font-weight: 600;
  line-height: 1;
  text-align: center;
}
.open-data-label {
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: 2rpx;
}

/* 简介 */
.open-body .sec-head {
  margin: 0 0 24rpx;
  padding: 0;
}
.open-intro-block {
  margin: 0;
}
.open-intro-text {
  font-size: 27rpx;
  color: var(--ink-2);
  line-height: 1.75;
  text-align: justify;
}

.open-footer { height: 40rpx; }
