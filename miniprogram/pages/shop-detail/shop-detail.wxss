.detail-page {
  min-height: 100vh;
  background: var(--bg);
}

.detail-hero {
  position: relative;
  overflow: hidden;
  padding: 44rpx 28rpx 52rpx;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  box-shadow: 0 18rpx 40rpx rgba(26, 22, 18, 0.18);
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%),
    linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
}

.detail-photo {
  display: block;
  width: 100%;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  background: #ece6d8;
}

.detail-hero--tea {
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%),
    linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
}

.detail-hero--meat {
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%),
    linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
}

.detail-hero--fish {
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%),
    linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
}

.detail-hero--noodle {
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%),
    linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
}

.detail-hero-ring {
  position: absolute;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.detail-hero-ring--a {
  width: 360rpx;
  height: 360rpx;
  right: -120rpx;
  top: -140rpx;
}

.detail-hero-ring--b {
  width: 200rpx;
  height: 200rpx;
  right: 30rpx;
  top: -40rpx;
}

.detail-hero-build {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  z-index: 2;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.detail-hero-eyebrow {
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.52);
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
}

.detail-hero-title {
  position: relative;
  z-index: 1;
  font-size: 56rpx;
  color: #ffffff;
  letter-spacing: 6rpx;
  line-height: 1.2;
}

.detail-hero-sub {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.64);
  letter-spacing: 2rpx;
}

.detail-body {
  padding: 32rpx 24rpx 60rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  border: 1rpx solid rgba(224, 214, 194, 0.92);
  box-shadow: 0 8rpx 24rpx rgba(26, 22, 18, 0.04);
}

.detail-section-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.detail-section-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #a63d2f;
  flex-shrink: 0;
}

.detail-section-heading-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1612;
  font-family: "Songti SC", "STSong", Georgia, serif;
  letter-spacing: 2rpx;
}

.detail-section-body {
  font-size: 28rpx;
  line-height: 1.85;
  color: #3a3028;
  text-align: justify;
}

.detail-cta-card {
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1A1612 0%, #3A332C 100%);
  text-align: center;
  overflow: hidden;
}

.detail-cta-mark {
  font-family: "Songti SC", "STSong", Georgia, serif;
  color: rgba(255, 255, 255, 0.62);
  font-size: 26rpx;
  letter-spacing: 6rpx;
}

.detail-cta-title {
  margin-top: 12rpx;
  font-family: "Songti SC", "STSong", Georgia, serif;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.detail-cta-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 23rpx;
  line-height: 1.7;
}
