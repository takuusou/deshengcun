<view class="notices-page">
  <view class="notices-body">
    <view class="empty" wx:if="{{loading && !filteredItems.length}}">
      <view class="empty-illust">⏳</view>
      <view class="empty-title">加载中</view>
    </view>

    <view class="empty" wx:elif="{{!filteredItems.length}}">
      <view class="empty-illust">📢</view>
      <view class="empty-title">暂无通知</view>
      <view class="empty-desc">村委暂未发布公告内容</view>
    </view>

    <view class="notice-list" wx:else>
      <block wx:for="{{filteredItems}}" wx:key="id">
        <view class="notice-row" data-id="{{item.id}}" bindtap="openNoticeDetail">
          <view class="notice-row-1">
            <text class="notice-pin" wx:if="{{item.is_home_top}}">置顶</text>
            <text class="notice-row-title">{{item.title}}</text>
          </view>
          <view class="notice-row-desc" wx:if="{{item.content_preview}}">{{item.content_preview}}{{item.content_more ? "…" : ""}}</view>
          <view class="notice-row-time">{{item.time_text}}</view>
        </view>
      </block>
    </view>
  </view>
</view>
