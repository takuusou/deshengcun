.svc-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* ── 品牌条（与首页一致） ── */
.h-brand {
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%),
    linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
  padding: 28rpx 44rpx 32rpx;
  position: relative;
  overflow: hidden;
}
.h-brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  min-height: 72rpx;
}
.h-brand-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 44rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 6rpx;
  line-height: 1.2;
}

/* ── 章节标题 ── */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
  margin-top: 48rpx;
  margin-bottom: 8rpx;
}
.sec-head-first { margin-top: 36rpx; }
.sec-head-l {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.sec-bar {
  width: 6rpx;
  height: 28rpx;
  background: var(--beni);
  border-radius: 3rpx;
  flex-shrink: 0;
}
.sec-title {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 3rpx;
  font-family: 'STSong', 'Songti SC', serif;
}
.sec-subtitle {
  font-size: 22rpx;
  color: var(--ink-4);
  letter-spacing: 1rpx;
}

/* ── 4列图标网格 ── */
.svc-grid-4 {
  padding: 0 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx 12rpx;
}
.svc-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
}
.svc-cell:active { opacity: 0.75; }
.svc-empty { visibility: hidden; }
.svc-cell-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  background: #fff;
  border: 1rpx solid var(--line-2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(26,22,18,0.06);
}
.svc-cell-img { width: 44rpx; height: 44rpx; }
.svc-cell-name {
  font-size: 25rpx;
  color: var(--ink);
  text-align: center;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.svc-loading {
  padding: 32rpx 36rpx;
  text-align: center;
}

/* ── 引导卡 ── */
.guide-card {
  margin: 48rpx 36rpx 36rpx;
  padding: 32rpx;
  background: var(--bg-2);
  border: 1rpx solid var(--line-2);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.guide-card:active { opacity: 0.8; }
.guide-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid var(--line-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.guide-icon-img { width: 36rpx; height: 36rpx; }
.guide-body { flex: 1; min-width: 0; }
.guide-title { font-size: 27rpx; color: var(--ink); font-weight: 500; letter-spacing: 1rpx; }
.guide-desc { font-size: 21rpx; color: var(--ink-3); margin-top: 6rpx; letter-spacing: 1rpx; }
.guide-link {
  font-size: 23rpx;
  color: var(--beni);
  font-weight: 500;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
