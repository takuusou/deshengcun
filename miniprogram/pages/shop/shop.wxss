.shop-page {
  min-height: 100vh;
  background: var(--bg);
}

.h-brand {
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%),
    linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
  padding: 28rpx 44rpx 32rpx;
  position: relative;
  overflow: hidden;
}
.h-brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  min-height: 72rpx;
}
.h-brand-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 44rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 6rpx;
  line-height: 1.2;
}

.eyebrow-hero {
  position: relative;
  overflow: hidden;
  margin: 0 0 24rpx;
  padding: 36rpx 28rpx 44rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  background: linear-gradient(135deg, #a63d2f 0%, #c04535 100%);
  box-shadow: 0 18rpx 36rpx rgba(166, 61, 47, 0.14);
}

.eyebrow-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 110% 110%, rgba(255, 255, 255, 0.12) 0%, transparent 50%);
}

.eyebrow-ring {
  position: absolute;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  pointer-events: none;
}

.eyebrow-ring--large {
  width: 320rpx;
  height: 320rpx;
  right: -100rpx;
  top: -120rpx;
}

.eyebrow-ring--small {
  width: 180rpx;
  height: 180rpx;
  right: 20rpx;
  top: -40rpx;
}

.eyebrow-title {
  position: relative;
  z-index: 1;
  font-size: 52rpx;
  color: #ffffff;
  letter-spacing: 10rpx;
}

.eyebrow-sub {
  position: relative;
  z-index: 1;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 2rpx;
}

.shop-body {
  padding: 24rpx 24rpx 36rpx;
}

.shop-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.shop-card {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(224, 214, 194, 0.96);
  box-shadow: 0 10rpx 24rpx rgba(26, 22, 18, 0.04);
}

.shop-card:active {
  opacity: 0.82;
}

.shop-card-hero {
  height: 180rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: #ece6d8;
}

.shop-card-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.shop-card-cover-empty {
  font-size: 22rpx;
  color: #b8afa3;
}

.shop-loading,
.shop-empty {
  text-align: center;
  color: #b8afa3;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.shop-card-hero--tea {
  background: linear-gradient(135deg, #1a2a16 0%, #2e4a28 100%);
}

.shop-card-hero--meat {
  background: linear-gradient(135deg, #2a1a10 0%, #4a2e1a 100%);
}

.shop-card-hero--fish {
  background: linear-gradient(135deg, #1a180a 0%, #3a360e 100%);
}

.shop-card-hero--noodle {
  background: linear-gradient(135deg, #2a1810 0%, #5c3520 100%);
}

.shop-card-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #a63d2f;
  color: #ffffff;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  font-family: "Songti SC", "STSong", Georgia, serif;
}

.shop-card-build {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.shop-card-mark {
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 76rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.18);
}

.shop-card-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #1a1612;
  font-weight: 600;
  font-family: "Songti SC", "STSong", Georgia, serif;
}

.shop-card-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #7a6e64;
}

.shop-card-foot {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f0ebe0;
}

.shop-card-read {
  font-size: 22rpx;
  color: #a63d2f;
}
