.me-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 40rpx;
}

/* Hero */
.me-hero {
  background: linear-gradient(135deg, var(--beni-d) 0%, var(--beni) 55%, var(--beni-l) 100%);
  padding: 48rpx 44rpx 56rpx;
  position: relative;
  overflow: hidden;
}
.me-hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%);
}
.me-hero-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.me-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.18);
  border: 3rpx solid rgba(255,255,255,0.4);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-family: 'STSong', 'Songti SC', serif;
  flex-shrink: 0;
}
.me-info { flex: 1; min-width: 0; }
.me-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  font-family: 'STSong', 'Songti SC', serif;
  letter-spacing: 2rpx;
}
.me-tip { margin-top: 6rpx; font-size: 23rpx; color: rgba(255,255,255,0.75); }
.me-login-btn {
  flex-shrink: 0;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.4);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 14rpx 28rpx;
  line-height: 1;
  margin: 0;
  min-height: 0;
}
.me-login-btn::after { border: 0; }

/* 菜单列表卡片 */
.me-list {
  margin: 36rpx;
  background: #fff;
  border: 1rpx solid var(--line-2);
  border-radius: 28rpx;
  overflow: hidden;
}
.me-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.me-row:last-child { border-bottom: 0; }
.me-row:active { background: var(--bg-2); }
.me-row-danger .me-row-name { color: var(--beni); }
.me-row-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: var(--beni-pale);
  color: var(--beni);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-family: 'STSong', 'Songti SC', serif;
  font-weight: 600;
  flex-shrink: 0;
}
.me-row-body { flex: 1; min-width: 0; }
.me-row-name { font-size: 28rpx; color: var(--ink); font-weight: 500; }
.me-row-desc { margin-top: 4rpx; font-size: 21rpx; color: var(--ink-4); }
.me-row-num {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--beni);
  font-family: 'STSong', 'Songti SC', serif;
  flex-shrink: 0;
}
.me-row-status {
  font-size: 21rpx;
  color: var(--ink-4);
  flex-shrink: 0;
}
.me-status-ok { color: var(--matcha); }
.me-status-warn { color: var(--beni); }
.me-row-arrow { font-size: 30rpx; color: var(--ink-4); flex-shrink: 0; }

.me-footer {
  margin-top: 56rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-4);
  letter-spacing: 2rpx;
}

.me-record-footer {
  width: 620rpx;
  max-width: calc(100% - 72rpx);
  margin: 248rpx auto 20rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 1.5;
}

.me-record-name {
  color: var(--ink-3);
}

.me-record-icp {
  margin-top: 8rpx;
  color: #3b82f6;
}
