.home-page {
  min-height: 100vh;
  background: var(--bg);
  padding-bottom: 32rpx;
}

/* ── 品牌条 ── */
.h-brand {
  background:
    radial-gradient(ellipse at 110% 110%, rgba(255,255,255,0.12) 0%, transparent 50%),
    radial-gradient(ellipse at -10% -10%, rgba(0,0,0,0.15) 0%, transparent 40%),
    linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
  padding: 28rpx 44rpx 32rpx;
  position: relative;
  overflow: hidden;
}
.h-brand-row {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  min-height: 72rpx;
}
.h-brand-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 44rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 6rpx;
  line-height: 1.2;
}

/* ── Banner ── */
.h-banner-wrap {
  padding: 32rpx 36rpx 0;
  position: relative;
}
.h-banner-swiper {
  width: 100%;
  height: 252rpx;
  background: #8A2E22;
  border-radius: 28rpx;
  overflow: hidden;
  transform: translateZ(0);
}
.h-banner {
  width: 100%;
  height: 252rpx;
  position: relative;
  transform: translateZ(0);
  backface-visibility: hidden;
}
.h-banner-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  transform: translateZ(0) scale(1.001);
  backface-visibility: hidden;
}
.h-banner-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    radial-gradient(ellipse at 80% 30%, rgba(255,255,255,0.15) 0%, transparent 50%),
    radial-gradient(ellipse at 20% 80%, rgba(0,0,0,0.2) 0%, transparent 50%),
    linear-gradient(135deg, #8A2E22 0%, #A63D2F 100%);
}
.h-banner.has-image .h-banner-bg {
  background: transparent;
}
.h-banner-body {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  padding: 44rpx 116rpx 22rpx 32rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.15) 45%, transparent 100%);
}
.h-banner-tag {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.25);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  width: fit-content;
}
.h-banner-tag-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #fff;
}
.h-banner-tag-txt {
  font-size: 18rpx;
  color: #fff;
  letter-spacing: 3rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.45);
}
.h-banner-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.35;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.55);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.h-banner-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.92);
  text-shadow: 0 3rpx 10rpx rgba(0,0,0,0.5);
}
.h-banner-dots {
  position: absolute;
  bottom: 24rpx;
  right: 68rpx;
  z-index: 5;
  display: flex;
  gap: 10rpx;
  pointer-events: none;
}
.h-banner-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.35);
  transition: width 220ms ease, background-color 220ms ease, opacity 220ms ease;
}
.h-banner-dot.on {
  background: rgba(255,255,255,0.9);
  width: 28rpx;
  border-radius: 6rpx;
}

/* ── 便民电话（滚动） ── */
.tel-wrap {
  margin: 36rpx 36rpx 0;
  padding: 28rpx 32rpx;
  background: #fff;
  border: 1rpx solid var(--line-2);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.tel-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--beni-pale);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.tel-icon-svg { width: 40rpx; height: 40rpx; }
.tel-info {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  overflow: hidden;
  position: relative;
}
.tel-roll {
  width: 100%;
  height: 80rpx;
}
.tel-roll-item {
  height: 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex-shrink: 0;
}
.tel-label {
  font-size: 21rpx;
  color: var(--ink-3);
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.tel-tag {
  font-size: 18rpx;
  color: var(--beni);
  font-weight: 500;
  background: var(--beni-pale);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}
.tel-num {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 34rpx;
  color: var(--ink);
  font-weight: 500;
  letter-spacing: 2rpx;
}
.tel-call {
  background: linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
  color: #fff;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 20rpx rgba(166,61,47,0.2);
  flex-shrink: 0;
  margin: 0;
  min-height: 0;
  line-height: 1;
}
.tel-call::after { border: 0; }
.tel-call-icon { width: 26rpx; height: 26rpx; }

/* ── 章节标题 ── */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
  margin-top: 48rpx;
  margin-bottom: 24rpx;
}
.sec-head-l { display: flex; align-items: center; gap: 18rpx; }
.sec-bar {
  width: 6rpx;
  height: 28rpx;
  background: var(--beni);
  border-radius: 3rpx;
}
.sec-title {
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 600;
  letter-spacing: 3rpx;
  font-family: 'STSong', 'Songti SC', serif;
}
.sec-more { font-size: 22rpx; color: var(--ink-4); }

/* ── 便民服务图标网格 ── */
.svc-grid-4 {
  padding: 0 24rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx 12rpx;
}
.svc-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
}
.svc-cell:active { opacity: 0.75; }
.svc-cell-icon-wrap { position: relative; }
.svc-cell-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  background: #fff;
  border: 1rpx solid var(--line-2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.svc-cell-img { width: 44rpx; height: 44rpx; }
.svc-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--beni);
  border: 2rpx solid #fff;
}
.svc-cell-name {
  font-size: 23rpx;
  color: var(--ink-2);
  letter-spacing: 1rpx;
  text-align: center;
}

/* ── 通知列表 ── */
.notice-list { padding: 0 36rpx; }
.notice-item {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.notice-item:last-child { border-bottom: none; }
.notice-item:active { opacity: 0.75; }
.notice-body { flex: 1; min-width: 0; }
.notice-title {
  font-size: 27rpx;
  color: var(--ink);
  font-weight: 400;
  line-height: 1.4;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.notice-time {
  font-size: 21rpx;
  color: var(--ink-4);
}
.notice-arrow {
  flex-shrink: 0;
  color: var(--ink-4);
  font-size: 28rpx;
}

/* 空状态 */
.notice-empty {
  margin: 0 36rpx;
  padding: 64rpx 24rpx 48rpx;
  background: var(--bg-2);
  border: 1rpx solid var(--line-2);
  border-radius: 28rpx;
  text-align: center;
}
.notice-empty-illust {
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--line-2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
}
.notice-empty-icon { width: 56rpx; height: 56rpx; }
.notice-empty-title {
  font-family: 'STSong', 'Songti SC', serif;
  font-size: 30rpx;
  color: var(--ink);
  font-weight: 500;
  letter-spacing: 2rpx;
}
.notice-empty-desc { margin-top: 10rpx; font-size: 23rpx; color: var(--ink-3); }

/* ── 通知订阅 CTA ── */
.notify-cta {
  margin: 56rpx 36rpx 32rpx;
  padding: 32rpx;
  background: var(--bg-2);
  border: 1rpx solid var(--line-2);
  border-radius: 28rpx;
}
.notify-cta-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 24rpx;
}
.notify-cta-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.notify-cta-icon-img { width: 32rpx; height: 32rpx; }
.notify-cta-text { flex: 1; }
.notify-cta-title { font-size: 26rpx; color: var(--ink); font-weight: 500; letter-spacing: 1rpx; }
.notify-cta-desc { font-size: 21rpx; color: var(--ink-3); margin-top: 6rpx; }
.notify-cta-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #A63D2F 0%, #C04535 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  min-height: 88rpx;
  letter-spacing: 6rpx;
  margin: 0;
  box-shadow: 0 8rpx 24rpx rgba(166,61,47,0.22);
}
.notify-cta-btn::after { border: 0; }
