.entry-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(190rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 24% 0%, rgba(166, 61, 47, 0.12), transparent 34%),
    linear-gradient(180deg, #f0ebe0 0%, #faf6ed 45%, #f7f0e6 100%);
  box-sizing: border-box;
}

.entry-hero {
  position: relative;
  overflow: hidden;
  min-height: 238rpx;
  border-radius: 30rpx;
  color: #ffffff;
  padding: 34rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #8a2e22 0%, #a63d2f 52%, #c04535 100%);
  box-shadow: 0 22rpx 42rpx rgba(166, 61, 47, 0.24);
}

.entry-hero::after {
  content: "";
  position: absolute;
  right: -58rpx;
  top: -52rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.16);
}

.entry-hero-title {
  position: relative;
  z-index: 1;
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.entry-hero-sub {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.76);
  letter-spacing: 1rpx;
}

.entry-hero-status {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  line-height: 1.6;
}

.entry-steps {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid #efe8da;
  box-shadow: 0 16rpx 34rpx rgba(82, 56, 35, 0.08);
}

.entry-step {
  flex: 1;
  text-align: center;
  color: #a09890;
}

.entry-step.active,
.entry-step.done {
  color: #a63d2f;
}

.entry-step-index {
  width: 46rpx;
  height: 46rpx;
  line-height: 46rpx;
  border-radius: 999rpx;
  margin: 0 auto;
  background: #efe8da;
  color: #7a6e64;
  font-size: 23rpx;
  font-weight: 700;
}

.entry-step.active .entry-step-index {
  background: #f5e8e6;
  color: #8a2e22;
  box-shadow: 0 0 0 6rpx rgba(166, 61, 47, 0.08);
}

.entry-step.done .entry-step-index {
  background: #a63d2f;
  color: #ffffff;
}

.entry-step-title {
  margin-top: 8rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.entry-step-line {
  width: 28rpx;
  height: 2rpx;
  background: #e0d6c2;
  margin: 0 2rpx;
}

.entry-card {
  margin-top: 22rpx;
  border-radius: 28rpx;
  padding: 30rpx 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #efe8da;
  box-shadow: 0 16rpx 34rpx rgba(82, 56, 35, 0.08);
}

.entry-card-title {
  font-family: "Songti SC", "STSong", Georgia, serif;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1612;
  letter-spacing: 1rpx;
}

.entry-login-ok {
  margin-top: 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e8c9c4;
  background: #f5e8e6;
  padding: 18rpx 20rpx;
}

.entry-login-name {
  color: #8a2e22;
  font-size: 30rpx;
  font-weight: 700;
  word-break: break-all;
}

.entry-login-meta {
  margin-top: 6rpx;
  color: #7a6e64;
  font-size: 24rpx;
}

.entry-consent-box,
.entry-face-box {
  margin-top: 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid #efe8da;
  background: #faf6ed;
  padding: 18rpx 20rpx;
}

.entry-consent-row {
  font-size: 25rpx;
  color: #5c5047;
  line-height: 1.7;
}

.policy-link,
.cadre-link {
  margin-top: 12rpx;
  display: inline-block;
  color: #a63d2f;
  text-decoration: underline;
  font-size: 25rpx;
}

.entry-inline-info {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #7a6e64;
  line-height: 1.6;
}

.entry-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.entry-actions .btn-primary,
.entry-actions .btn-secondary {
  width: 100%;
}

.entry-face-title {
  font-size: 27rpx;
  color: #1a1612;
  font-weight: 600;
}

.entry-face-note {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7a6e64;
}

.entry-face-preview {
  margin-top: 12rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  background: #efe8da;
}

.mt-12 {
  margin-top: 16rpx;
}

.withdraw-btn {
  width: 100%;
  min-height: 76rpx;
  line-height: 76rpx;
  border-radius: 18rpx;
  background: #f5e8e6;
  color: #8a2e22;
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid #e8c9c4;
}

.entry-bottom-actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: rgba(250, 246, 237, 0.96);
  border: 1rpx solid rgba(224, 214, 194, 0.9);
  box-shadow: 0 -12rpx 30rpx rgba(82, 56, 35, 0.12);
  backdrop-filter: blur(10rpx);
  box-sizing: border-box;
  z-index: 20;
}

.entry-bottom-btn {
  flex: 1;
  width: auto;
  margin-top: 0;
}

.cadre-entry {
  padding: 12rpx 0 0;
  text-align: center;
}

.cadre-panel {
  margin-bottom: 12rpx;
}

.withdraw-btn::after {
  border: 0;
}
