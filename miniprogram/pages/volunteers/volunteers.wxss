page {
  background: #f6f4ef;
}

.records-page {
  min-height: 100vh;
  background: #f6f4ef;
}

/* 顶部 tab */
.record-tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #ede6d8;
  padding: 0 14rpx;
  position: sticky;
  top: 0;
  z-index: 5;
}
.record-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0 22rpx;
  font-size: 27rpx;
  color: #7a6e64;
  position: relative;
}
.record-tab.on {
  color: #a63d2f;
  font-weight: 500;
}
.record-tab.on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 5rpx;
  background: #a63d2f;
  border-radius: 4rpx;
}
.record-tab-badge {
  display: inline-block;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  padding: 0 6rpx;
  margin-left: 6rpx;
  background: #a63d2f;
  color: #fff;
  font-size: 19rpx;
  border-radius: 14rpx;
  vertical-align: middle;
}

.records-body {
  padding: 20rpx 24rpx 40rpx;
}

/* 压扁记录条 */
.rec-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}
.rec-row {
  background: #fff;
  border: 1rpx solid #e8e0d0;
  border-radius: 18rpx;
  padding: 24rpx 26rpx;
}
.rec-row-1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.rec-row-title {
  font-size: 29rpx;
  color: #1a1612;
  font-weight: 600;
  font-family: "Songti SC", "STSong", serif;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.rec-status {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  font-weight: 500;
}
.rec-status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.rec-status-done {
  color: #3d6b45;
}
.rec-status-done .rec-status-dot {
  background: #3d6b45;
}
.rec-status-doing {
  color: #b07a28;
}
.rec-status-doing .rec-status-dot {
  background: #b07a28;
}
.rec-status-back {
  color: #a63d2f;
}
.rec-status-back .rec-status-dot {
  background: #a63d2f;
}
.rec-row-2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.rec-row-type {
  font-size: 22rpx;
  color: #7a6e64;
  background: #f6f4ef;
  padding: 4rpx 16rpx;
  border-radius: 14rpx;
}
.rec-row-date {
  font-size: 22rpx;
  color: #b8afa3;
}

/* 空状态 */
.rec-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 120rpx 48rpx 60rpx;
}
.rec-empty-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #e8e0d0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #b8afa3;
  font-family: "Songti SC", "STSong", serif;
  margin-bottom: 32rpx;
}
.rec-empty-title {
  font-size: 30rpx;
  color: #7a6e64;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.rec-empty-desc {
  font-size: 24rpx;
  color: #b8afa3;
  line-height: 1.8;
  max-width: 460rpx;
  margin-bottom: 32rpx;
}
.rec-empty-btn {
  padding: 0 48rpx;
  height: 76rpx;
  line-height: 76rpx;
  border: 1rpx solid #e8e0d0;
  border-radius: 18rpx;
  background: #fff;
  color: #a63d2f;
  font-size: 26rpx;
}
