.material-flow-page {
  min-height: 100vh;
  background: #faf6ed;
  color: #1a1612;
  padding-bottom: 42rpx;
}

.h-brand {
  position: relative;
  overflow: hidden;
  padding: 34rpx 44rpx 38rpx;
  background: linear-gradient(118deg, #8a2e22 0%, #a63d2f 48%, #c04535 100%);
}

.h-brand::before,
.h-brand::after {
  content: "";
  position: absolute;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.13);
}

.h-brand::before {
  right: -72rpx;
  top: -60rpx;
  width: 250rpx;
  height: 250rpx;
}

.h-brand::after {
  right: 8rpx;
  bottom: -116rpx;
  width: 190rpx;
  height: 190rpx;
}

.h-brand-title {
  position: relative;
  z-index: 1;
  color: #fff;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}

.h-brand-sub {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.flow-body {
  padding: 28rpx 28rpx 40rpx;
}

.intro-card {
  display: flex;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid #ece3d2;
  box-shadow: 0 12rpx 26rpx rgba(82, 56, 35, 0.05);
}

.intro-mark {
  color: #a63d2f;
  font-size: 34rpx;
  line-height: 1.1;
}

.intro-text {
  flex: 1;
  color: #6b6258;
  font-size: 26rpx;
  line-height: 1.65;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 30rpx 4rpx 18rpx;
}

.section-bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 6rpx;
  background: #a63d2f;
}

.section-title {
  font-family: "STSong", "Songti SC", "SimSun", serif;
  color: #1a1612;
  font-size: 31rpx;
  font-weight: 600;
}

.section-count {
  margin-left: auto;
  color: #9a9082;
  font-size: 23rpx;
}

.material-list {
  display: grid;
  gap: 14rpx;
}

.material-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid #ece3d2;
  box-shadow: 0 8rpx 20rpx rgba(82, 56, 35, 0.04);
}

.material-index {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #a63d2f;
  background: #f5e8e6;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-weight: 700;
}

.material-name {
  flex-shrink: 0;
  color: #1a1612;
  font-size: 29rpx;
  font-weight: 600;
}

.material-desc {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: #9a9082;
  font-size: 24rpx;
  line-height: 1.45;
}

.primary-btn,
.ghost-btn {
  margin: 0;
  min-height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  box-sizing: border-box;
}

.primary-btn {
  margin-top: 34rpx;
  color: #fff;
  background: #a63d2f;
  box-shadow: 0 12rpx 22rpx rgba(166, 61, 47, 0.16);
  font-weight: 600;
}

.ghost-btn {
  color: #6b6258;
  background: #fff;
  border: 1rpx solid #e0d4bf;
}

.primary-btn.compact {
  margin-top: 0;
}

.progress-card,
.upload-card,
.receipt-card {
  background: #fff;
  border: 1rpx solid #ece3d2;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 26rpx rgba(82, 56, 35, 0.05);
}

.progress-card {
  padding: 28rpx 22rpx 30rpx;
  margin-bottom: 24rpx;
}

.progress-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.progress-title {
  color: #6b6258;
  font-size: 25rpx;
  font-weight: 600;
}

.progress-count {
  margin-left: auto;
  color: #a63d2f;
  font-size: 25rpx;
  font-weight: 700;
}

.progress-nodes {
  display: flex;
  align-items: flex-start;
}

.progress-node {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: #9a9082;
}

.progress-link {
  position: absolute;
  top: 23rpx;
  left: 50%;
  right: -50%;
  height: 3rpx;
  background: #e7ddcb;
}

.progress-node:last-child .progress-link {
  display: none;
}

.progress-link.passed {
  background: #3d6b35;
}

.progress-dot {
  position: relative;
  z-index: 1;
  width: 46rpx;
  height: 46rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  background: #f1eadd;
  color: #9a9082;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 23rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.progress-node.done .progress-dot {
  color: #fff;
  background: #3d6b35;
}

.progress-node.cur .progress-dot {
  color: #a63d2f;
  background: #fff;
  border-color: #a63d2f;
  box-shadow: 0 0 0 8rpx #f5e8e6;
}

.progress-label {
  max-width: 92rpx;
  color: #9a9082;
  font-size: 20rpx;
  line-height: 1.25;
  text-align: center;
}

.progress-node.cur .progress-label {
  color: #a63d2f;
  font-weight: 600;
}

.upload-card {
  padding: 34rpx 28rpx 30rpx;
}

.upload-tag {
  display: inline-flex;
  padding: 6rpx 18rpx;
  border-radius: 12rpx;
  background: #f5e8e6;
  color: #a63d2f;
  font-size: 22rpx;
  font-weight: 600;
}

.upload-title {
  margin-top: 20rpx;
  color: #1a1612;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 600;
}

.upload-desc {
  margin-top: 10rpx;
  color: #9a9082;
  font-size: 25rpx;
  line-height: 1.55;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 30rpx;
}

.photo-item,
.photo-add {
  width: 156rpx;
  height: 156rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
}

.photo-item {
  position: relative;
  overflow: hidden;
  border: 1rpx solid #ece3d2;
  background: #efe9dc;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 0 22rpx 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: rgba(26, 22, 18, 0.62);
  font-size: 28rpx;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  line-height: 1;
  color: #a63d2f;
  background: rgba(166, 61, 47, 0.035);
  border: 3rpx dashed rgba(166, 61, 47, 0.45);
}

.photo-plus {
  font-size: 52rpx;
  line-height: 1;
  font-weight: 300;
}

.photo-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.upload-hint {
  margin-top: 22rpx;
  color: #9a9082;
  font-size: 23rpx;
  line-height: 1.55;
}

.done-body {
  padding: 92rpx 42rpx 48rpx;
  text-align: center;
}

.done-check {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  margin: 0 auto 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5e8e6;
}

.done-check::before {
  content: "";
  position: absolute;
  inset: -16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(166, 61, 47, 0.18);
}

.done-check-inner {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #a63d2f;
  font-size: 56rpx;
  font-weight: 700;
}

.done-title {
  color: #1a1612;
  font-family: "STSong", "Songti SC", "SimSun", serif;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.done-message {
  margin-top: 26rpx;
  color: #6b6258;
  font-size: 27rpx;
  line-height: 1.85;
}

.receipt-card {
  margin-top: 42rpx;
  padding: 28rpx 30rpx;
  text-align: left;
}

.receipt-head {
  display: flex;
  align-items: center;
  color: #9a9082;
  font-size: 24rpx;
  margin-bottom: 18rpx;
}

.receipt-ok {
  margin-left: auto;
  color: #3d6b35;
  font-weight: 600;
}

.receipt-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 10rpx 0;
  color: #1a1612;
  font-size: 26rpx;
}

.receipt-dot {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #3d6b35;
  font-size: 20rpx;
}

.receipt-name {
  flex: 1;
}

.receipt-count,
.receipt-empty {
  color: #9a9082;
  font-size: 24rpx;
}

.done-actions {
  display: grid;
  grid-template-columns: 1fr 1.25fr;
  gap: 18rpx;
  margin-top: 46rpx;
}
